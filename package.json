{
  "name": "signalk-openweather-provider",
  "version": "1.0.4",
  "description": "OpenWeather provider plugin for Signal K Server",
  "main": "plugin/index.js",
  "signalk": {
    "displayName": "OpenWeather Provider",
    "appIcon": "./app-icon.svg"
  },
  "scripts": {
    "build": "tsc",
    "build-declaration": "tsc --declaration --allowJs false",
    "watch": "npm run build -- -w",
    "start": "npm run watch",
    "prepack": "tsc",
    "prepublishOnly": "tsc",
    "prettier": "prettier -w src/",
    "format": "npm run prettier",
    "test": "mocha"
  },
  "license": "Apache-2.0",
  "keywords": [
    "signalk",
    "signalk-node-server-plugin",
    "signalk-category-weather"
  ],
  "author": {
    "name": "AdrianP"
  },
  "dependencies": {
    "@signalk/server-api": "^2.28.0",
    "geolib": "^3.3.4",
    "ngeohash": "^0.6.3",
    "tslib": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/panaaj/signalk-openweather-provider"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/ngeohash": "^0.6.8",
    "@types/node": "^18.14.4",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
